VertexLitGeneric
{
	"$basetexture"	"models\unitvehiclescars\uv_viperelite\Textures\viperelite_misc"
    "$color" "{255 255 255}"

    "$blendtintbyvertexalpha" "1"
    "$blendtintcoloroverbase" "1"
	
    "$envmap" "env_cubemap"
    "$envmaptint" "[0.75 0.75 0.75]"

    "$phong" "1"
    "$phongexponent" "15"
    "$phongboost" "1"
    "$phongfresnelranges" "[0.05 0.5 1]"
    "$basemapalphaphongmask" "0"
	
	"$color2"	"[0.75 0.75 0.75]"

	Proxies
	{
		Equals
		{
			srcVar1				$color2
			resultVar			$color
		}
	}
}